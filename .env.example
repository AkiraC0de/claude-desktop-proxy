# mimo-proxy provider settings — edit freely, re-read per request
# Anthropic-compatible endpoint (XKIRO speaks /v1/messages)
PROVIDER_BASE_URL=
# API key for the provider (sent as Authorization: Bearer; use AUTH_STYLE=x-api-key if needed)
API_KEY=
AUTH_STYLE=bearer
# Optional shared secret. If set, clients must send it as their API key
# (Claude Code: ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN = this value).
PROXY_TOKEN=
